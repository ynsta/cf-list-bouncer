# cf-list-bouncer configuration. Copy to .env (git-ignored) and fill in:
#   cp .env.example .env && chmod 600 .env
# Used with `docker run --env-file .env` or Compose `env_file: .env`.
# Values are taken literally: do not quote them.
# Full reference: README.md, "Configuration".

# --- Required ---------------------------------------------------------------

# CrowdSec LAPI, as reachable from the container.
CROWDSEC_LAPI_URL=http://crowdsec:8080
# Bouncer key printed by: cscli bouncers add cf-list-bouncer
CROWDSEC_LAPI_KEY=

# Cloudflare API token with only "Account Filter Lists: Edit" (docs/sre/cloudflare-setup.md).
CF_API_TOKEN=
# 32 lowercase hex characters each.
CF_ACCOUNT_ID=
CF_LIST_ID=

# Secrets can come from files instead (Docker secrets); set NAME or NAME_FILE, not both.
#CROWDSEC_LAPI_KEY_FILE=/run/secrets/crowdsec_lapi_key
#CF_API_TOKEN_FILE=/run/secrets/cf_api_token

# --- Optional (defaults shown) ----------------------------------------------

# Decision origins to sync; add e.g. lists:<name> to include a blocklist.
#ORIGINS=crowdsec,cscli
#SYNC_INTERVAL=30s
# Push an unchanged list this often to undo manual edits; 0s disables.
#RESYNC_INTERVAL=1h
#IPV6_PREFIX=64
# Set to your Cloudflare plan's list item limit.
#MAX_ITEMS=10000
#LISTEN_ADDR=:9090
# Exit after this many failed syncs in a row (0 = never).
#MAX_CONSECUTIVE_FAILURES=20
#LOG_LEVEL=info
